---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Bento, { type Block } from '../components/Bento.astro';
import content from '../content/pages.json';

type Page = { title: string; description: string; blocks: Block[] };
export function getStaticPaths() {
  return Object.entries(content)
    .filter(([k]) => !k.startsWith('_'))
    .map(([slug, page]) => ({ params: { slug }, props: { page: page as Page } }));
}
const { page } = Astro.props as { page: Page };
// The legacy first Bloc is the page title card → becomes the header band.
const [first, ...rest] = page.blocks;
const isTitle = !!first && first.items.length <= 2 && !first.items.some((i) => i.html.length > 200);
const blocks = isTitle ? rest : page.blocks;
const head = isTitle ? first : undefined;
---
<Base title={page.title || head?.items[0]?.html || 'Chanvre Québec'} description={page.description}>
  <PageHead title={head?.items[0]?.html ?? page.title} lede={head?.items[1]?.html} image={head?.photo ?? blocks.find((b) => b.photo && !b.items.length)?.photo} />
  <section class="max-w-[1800px] mx-auto px-8 max-[479px]:px-4 pt-16 max-[479px]:pt-8">
    <Bento blocks={blocks} />
  </section>
</Base>
